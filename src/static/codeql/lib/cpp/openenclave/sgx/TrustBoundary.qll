/**
 * Provides classes modeling the Open Enclave (Intel SGX) trust boundary: which
 * code runs inside the enclave, the oeedger8r-generated ECALL/OCALL stubs and
 * the values that the untrusted host controls.
 */

import cpp
import semmle.code.cpp.ir.dataflow.DataFlow
private import semmle.code.cpp.dataflow.ExternalFlow as ExternalFlow
import Edl

private predicate fileIncludes(File includer, File included) {
  exists(Include i | i.getFile() = includer and i.getIncludedFile() = included)
}

/** A primary source file compiled into an enclave. */
class EnclaveTranslationUnit extends File {
  EnclaveTranslationUnit() {
    exists(Compilation c | c.getAFileCompiled() = this |
      c.getAnArgument().matches("-DOE_BUILD_ENCLAVE%")
      or
      exists(File h |
        fileIncludes+(this, h) and
        h.getAbsolutePath()
            .matches(["%/openenclave/enclave.h", "%/openenclave/edger8r/enclave.h"])
      )
    )
  }
}

/** Holds if `f` is compiled into an enclave, directly or through an include. */
predicate isEnclaveFile(File f) {
  f instanceof EnclaveTranslationUnit
  or
  exists(EnclaveTranslationUnit tu | fileIncludes+(tu, f))
}

/** Holds if `e` is part of code compiled into an enclave. */
predicate isEnclaveCode(Element e) { isEnclaveFile(e.getFile()) }

/** Holds if data-flow node `n` is in code compiled into an enclave. */
predicate isEnclaveNode(DataFlow::Node n) { isEnclaveFile(n.getLocation().getFile()) }

/** Gets the name of struct `s` without a leading `_` or trailing `_t`. */
bindingset[s]
string normalizedTypeName(string s) { result = s.regexpReplaceAll("^_|_t$", "") }

/** Holds if `f` is generated by oeedger8r. */
predicate isGeneratedEdgeFile(File f) { f.getBaseName().regexpMatch(".*_(t|u|args)\\.(c|h)") }

/**
 * An oeedger8r-generated ECALL dispatcher (`ecall_<name>`). It validates and
 * unmarshals the input buffer, then calls the user implementation.
 */
class EcallStub extends Function {
  EcallStub() {
    this.getName().matches("ecall\\_%") and
    this.getNumberOfParameters() = 5 and
    this.getParameter(0).getName() = "input_buffer" and
    this.getParameter(4).getName() = "output_bytes_written"
  }

  /** Gets the call to the user-implemented ECALL function. */
  FunctionCall getImplementationCall() {
    result.getEnclosingFunction() = this and
    result.getTarget().getName() = this.getName().suffix(6)
  }
}

/** A function implementing an ECALL; all of its inputs are chosen by the host. */
class EcallImplementation extends Function {
  EcallImplementation() {
    this = any(EcallStub s).getImplementationCall().getTarget()
    or
    this.(EdlFunction).isEcall() and this.hasDefinition()
  }

  /**
   * Holds if parameter `i` is a host pointer passed into the enclave without
   * validation (`[user_check]` in the EDL).
   */
  predicate isUserCheckParameter(int i) {
    this.(EdlFunction).hasParamAttribute(i, "user_check")
    or
    // Without EDL data: a pointer copied verbatim from the marshalling struct.
    // `[in]`/`[out]` pointers are re-pointed into enclave memory by the stub.
    exists(EcallStub s, FunctionCall c, PointerFieldAccess fa |
      c = s.getImplementationCall() and
      c.getTarget() = this and
      fa = c.getArgument(i).getUnconverted() and
      fa.getQualifier().(VariableAccess).getTarget().getName() = "_pargs_in" and
      fa.getTarget().getUnspecifiedType() instanceof PointerType and
      not exists(Assignment a |
        a.getEnclosingFunction() = s and
        a.getLValue().(FieldAccess).getTarget() = fa.getTarget()
      )
    )
  }
}

/** An enclave-side OCALL proxy (generated by oeedger8r or declared in an EDL). */
class OcallProxy extends Function {
  OcallProxy() {
    this.(EdlFunction).isOcall()
    or
    this.getName().matches("%\\_ocall") and
    exists(FunctionCall c |
      c.getEnclosingFunction() = this and
      c.getTarget().getName() = ["oe_call_host_function", "oe_switchless_call_host_function"]
    )
  }

  /**
   * Holds if, at a call to this proxy, the host writes the memory pointed to by
   * argument `i` (the `_retval` slot or an `[out]` parameter).
   */
  predicate isHostWrittenArgument(int i) {
    exists(EdlFunction f | f = this |
      f.getEdlReturnType() != "void" and i = 0
      or
      exists(int e | f.hasParamAttribute(e, "out") and i = f.getProxyArgumentIndex(e))
    )
    or
    not this instanceof EdlFunction and
    i = 0 and
    this.getParameter(0).getName() = "_retval"
  }
}

/** A call from enclave code to an OCALL proxy. */
class OcallProxyCall extends FunctionCall {
  OcallProxyCall() {
    isEnclaveCode(this) and
    (
      this.getTarget() instanceof OcallProxy
      or
      // Proxies of application EDLs that are declared but not modeled.
      this.getTarget().getName().matches("%\\_ocall") and
      this.getArgument(0).getUnconverted() instanceof AddressOfExpr and
      this.getTarget().getType().getName() = "oe_result_t"
    )
  }

  /** Holds if the host writes the memory designated by argument `i`. */
  predicate isHostWrittenArgument(int i) {
    this.getTarget().(OcallProxy).isHostWrittenArgument(i)
    or
    not this.getTarget() instanceof OcallProxy and i = 0
  }
}

/**
 * A value produced by the host and consumed by enclave code: an OCALL return
 * value or `[out]` data (the Iago attack surface).
 */
class OcallOutput extends DataFlow::Node {
  OcallOutput() {
    isEnclaveNode(this) and
    (
      ExternalFlow::sourceNode(this, "oe-ocall-output")
      or
      // Proxies without generated models (the EDL was not run through edl2codeql.py).
      exists(OcallProxyCall c, int i |
        not c.getTarget() instanceof EdlFunction and
        c.isHostWrittenArgument(i) and
        this.asDefiningArgument() = c.getArgument(i)
      )
    )
  }
}

/** A host-controlled ECALL input observed inside the enclave. */
class EcallInput extends DataFlow::Node {
  EcallInput() {
    ExternalFlow::sourceNode(this, "oe-ecall-input")
    or
    exists(EcallImplementation f, Parameter p | p = f.getAParameter() |
      not f instanceof EdlFunction and
      (
        p.getUnspecifiedType() instanceof PointerType and this.asParameter(1) = p
        or
        not p.getUnspecifiedType() instanceof PointerType and this.asParameter() = p
      )
    )
  }
}

/**
 * Struct fields of the Open Enclave ABI that hold pointers chosen by the host.
 * Values read from them must be validated with `oe_is_outside_enclave`.
 */
class HostPointerField extends Field {
  HostPointerField() {
    exists(string s, string f |
      normalizedTypeName(this.getDeclaringType().getName()) = s and this.getName() = f
    |
      s = "oe_call_enclave_function_args" and f = ["input_buffer", "output_buffer"]
      or
      s = "oe_ecall_context" and f = ["ocall_buffer", "debug_eenter_rbp", "debug_eenter_rip"]
      or
      s = ["oe_enclave_worker_context", "oe_host_worker_context"] and f = "call_arg"
    )
  }
}

/**
 * Parameters of internal Open Enclave entry points that carry raw host
 * register values (RDI/RSI at EENTER and ORET).
 */
predicate isHostRegisterParameter(Parameter p) {
  exists(Function f, int i | p = f.getParameter(i) |
    f.hasName("__oe_handle_main") and i = [0, 1]
    or
    f.hasName("_handle_ecall") and i = [1, 2]
    or
    f.hasName("_handle_oret") and i = [1, 2, 3]
    or
    f.hasName(["oe_handle_call_enclave_function", "_handle_init_enclave"]) and i = 0
    or
    f.hasName("oe_virtual_exception_dispatcher") and i = 1
  )
}

/** A pointer value chosen by the host: it may point anywhere, including into the enclave. */
class HostChosenPointer extends DataFlow::Node {
  HostChosenPointer() {
    isEnclaveNode(this) and
    (
      ExternalFlow::sourceNode(this, "oe-host-pointer")
      or
      exists(EcallImplementation f, int i |
        f.isUserCheckParameter(i) and this.asParameter() = f.getParameter(i)
      )
      or
      isHostRegisterParameter(this.asParameter())
      or
      exists(FieldAccess fa | fa.getTarget() instanceof HostPointerField |
        this.asExpr() = fa and not fa.isUsedAsLValue()
      )
    )
  }
}
